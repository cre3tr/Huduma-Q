rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Sessions: anyone can fetch one doc by its exact ID (the magic link), but
    // nobody can list the collection. `get`, not `read`: `read` also grants
    // `list`. Cloud Functions write.
    match /sessions/{docId} {
      allow get: if true;
      allow write: if false;  // Cloud Functions only via Admin SDK
    }

    // Slots: anyone can read (for SlotGrid), Cloud Functions write
    match /slots/{slotId} {
      allow read: if true;
      allow write: if false;
    }

    // Appointments: staff only (a signed-in user with a staff/{uid} doc) can
    // read. Cloud Functions write.
    match /appointments/{appointmentId} {
      allow read: if request.auth != null
        && exists(/databases/$(database)/documents/staff/$(request.auth.uid));
      allow write: if false;
    }

    // Rate-limit counters: Cloud Functions only (Admin SDK bypasses rules).
    match /rate_limits/{docId} {
      allow read, write: if false;
    }

    // Staff: authenticated users can read their own doc
    match /staff/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
